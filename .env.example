# --- Push (marco 1) -------------------------------------------------------
# Gere as duas primeiras UMA vez só, com: npm run gerar-vapid
# Trocar depois invalida todas as inscrições e o push passa a falhar com 403.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu@email.com

# --- Banco (passo 2) ------------------------------------------------------
# Supabase > Project Settings > Database > Connection string > URI.
# Use a porta 6543 (pooler) na Vercel; a 5432 serve para migrations locais.
DATABASE_URL=

# --- Auth (passo 3, ainda não usado) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron (passo 9, ainda não usado) --------------------------------------
# Segredo que o pg_cron manda no header para poder chamar /api/cron/*.
CRON_SECRET=
